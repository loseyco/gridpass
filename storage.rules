rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // User avatars
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /images/users/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Vehicle showcase pictures & vehicle media
    match /vehicles/{userId}/{vehicleId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /vehicles/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Event & Sightings photos
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sightings/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Secure private user directories
    match /private/users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Fallback rule for authenticated uploads
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
