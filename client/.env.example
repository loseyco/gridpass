# GridPass Client Environment Variables
# Copy this to .env and fill in your values

# GridPass API (use localhost for dev, production URL for live)
API_BASE_URL=http://localhost:3000/api
API_BASE_URL_PROD=https://gridpass.app/api

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Your GridPass Access Token (get from browser DevTools)
# localStorage.getItem('supabase.auth.token')
AUTH_TOKEN=your-access-token-here

# Module Settings
ENABLE_SIM_RACING=true
ENABLE_REAL_TELEMETRY=false
ENABLE_FILE_SYNC=false
