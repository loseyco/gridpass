{
  "name": "gridpass-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"NEXT,FEEDS\" -c \"cyan,magenta\" \"next dev --port 3000\" \"tsx scripts/local_rss_daemon.ts\"",
    "dev:web": "next dev --port 3000",
    "build": "next build",
    "lint": "turbo run lint",
    "test": "node run-tests.js --all",
    "test:headed": "playwright test tests/admin_ops.spec.ts --headed",
    "feeds:daemon": "tsx scripts/local_rss_daemon.ts",
    "changeset": "changeset"
  },
  "dependencies": {
    "@emnapi/runtime": "^1.10.0",
    "@google/generative-ai": "^0.24.1",
    "@opentelemetry/api": "^1.9.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@types/qrcode": "^1.5.6",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.3.2",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "next": "16.2.6",
    "nookies": "^2.5.2",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rss-parser": "^3.13.0",
    "stripe": "^14.22.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "turbo": "^2.0.0",
    "typescript": "^5"
  }
}
