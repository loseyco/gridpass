rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Centralized Logging & Telemetry
    match /system_logs/{logId} { allow read, write: if true; }
    match /tag_scans/{scanId} { allow read, write: if true; }
    match /system_settings/{settingId} { allow read, write: if true; }
    match /changelogs/{changelogId} { allow read, write: if true; }

    // Agent Swarm, SOP Knowledge Base & Operational Tickets
    match /agent_tickets/{ticketId} { allow read, write: if true; }
    match /agent_staff/{staffId} { allow read, write: if true; }
    match /sops/{sopId} { allow read, write: if true; }
    match /swarm_interlock/{questionId} { allow read, write: if true; }

    // User Feedback & Partner Request Queues
    match /user_feedback/{feedbackId} { allow read, write: if true; }
    match /feedback_queue/{ticketId} { allow read, write: if true; }
    match /client_feedback/{feedbackId} { allow read, write: if true; }
    match /partner_requests/{requestId} { allow read, write: if true; }

    // Core Platform Entities (Members, Vehicles, Businesses, Events)
    match /users/{userId} { allow read, write: if true; }
    match /members/{memberId} { allow read, write: if true; }
    match /vehicles/{vehicleId} { allow read, write: if true; }
    match /businesses/{businessId} { allow read, write: if true; }
    match /events/{eventId} { allow read, write: if true; }
    match /features/{featureId} { allow read, write: if true; }

    // Event Ownership Claims, Radar Pins & Community News
    match /event_claims/{id} { allow read, write: if true; }
    match /event_pins/{id} { allow read, write: if true; }
    match /event_news/{id} { allow read, write: if true; }
    match /event_discussions/{id} { allow read, write: if true; }

    // B2B Sales Engine, CRM Deals & Products Catalog
    match /products/{productId} { allow read, write: if true; }
    match /proposals/{proposalId} { allow read, write: if true; }
    match /crm_deals/{dealId} { allow read, write: if true; }
    match /sales_leads/{leadId} { allow read, write: if true; }
    match /industries/{industryId} { allow read, write: if true; }
    match /staff/{staffId} { allow read, write: if true; }

    // Gamification, Loyalty & Points Engine
    match /reward_rules/{ruleId} { allow read, write: if true; }
    match /rewards_catalog/{rewardId} { allow read, write: if true; }
    match /points_logs/{logId} { allow read, write: if true; }
    match /membership_tiers/{tierId} { allow read, write: if true; }

    // Access Control, Venue Gate Badges & IoT Checkins
    match /venue_checkins/{id} { allow read, write: if true; }
    match /checkins/{id} { allow read, write: if true; }
    match /orders/{id} { allow read, write: if true; }
    match /gridpass_parks/{id} { allow read, write: if true; }
    match /gridpass_checkins/{id} { allow read, write: if true; }

    // Vehicle Logs, Maintenance & Expenses
    match /service_logs/{id} { allow read, write: if true; }
    match /expenses/{id} { allow read, write: if true; }
    match /vehicle_trails/{id} { allow read, write: if true; }

    // Live Venue Radar & Public Spots
    match /sightings/{id} { allow read, write: if true; }
    match /venue_radar/{id} { allow read, write: if true; }
    match /spots/{id} { allow read, write: if true; }

    // Second Life Sim & Club Management SaaS Collections
    match /sl_avatars/{id} { allow read, write: if true; }
    match /sl_venues/{id} { allow read, write: if true; }
    match /sl_venues/{id}/{document=**} { allow read, write: if true; }
    match /sl_telemetry/{id} { allow read, write: if true; }
    match /sl_sessions/{id} { allow read, write: if true; }

    // Voyage AI Adventure Cockpit
    match /voyage_trips/{id} { allow read, write: if true; }
    match /voyage_manifests/{id} { allow read, write: if true; }
    match /voyage_pets/{id} { allow read, write: if true; }
    match /voyage_gates/{id} { allow read, write: if true; }
    match /voyage_riders/{id} { allow read, write: if true; }
    match /voyage_pitches/{id} { allow read, write: if true; }
    match /voyage_claims/{id} { allow read, write: if true; }
    match /voyage_tickets/{id} { allow read, write: if true; }
    match /voyage_checkins/{id} { allow read, write: if true; }
    match /voyage_tags/{id} { allow read, write: if true; }

    // Track Waivers, Show Votes, Radar & Interest Registry
    match /interest_registry/{id} { allow read, write: if true; }
    match /radar/{id} { allow read, write: if true; }
    match /show_votes/{id} { allow read, write: if true; }
    match /track_releases/{id} { allow read, write: if true; }
    match /track_waivers/{id} { allow read, write: if true; }

    // Universal Dynamic update exception / fallback
    match /{collection}/{document} {
      allow update: if true;
    }
  }
}


